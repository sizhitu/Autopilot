# ============================================================================
#  Autopilot 环境变量示例
#  复制为 .env（本地）或在 Render 控制台逐项填写。不要提交真实密钥。
# ============================================================================

# ---- Supabase（认证 + 唯一业务数据库）----
# Supabase 控制台 → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings → API → JWT Secret（后端校验前端 JWT 用）
SUPABASE_JWT_SECRET=your-jwt-secret

# 本地开发未配置 SUPABASE_URL 时，自动回退到 SQLite：
# DATABASE_PATH=./autopilot.db

# ---- 缓存层 ----
# 留空则回退到 Postgres `cache` 表；接入 Upstash Redis 后填写：
# UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ---- 应用邮件（EDM / 客服工单，走 Resend API）----
# 认证邮件在 Supabase 后台把 Auth 邮件绑定 Resend；此处仅用于应用自身发信。
RESEND_API_KEY=re_xxxxxxxx
SUPPORT_EMAIL=support@timebricks.bid
SITE_NAME=Autopilot 投资分析

# ---- 跨域 / 管理员 ----
CORS_ORIGINS=https://timebricks.bid,https://autopilot.pages.dev
# 额外管理员邮箱（逗号分隔）
ADMIN_EMAILS=

# ---- AI 周报 / 月报（OpenAI 兼容接口）----
# 未配置 AI_API_KEY 时，报告降级为结构化纯文本 HTML，不中断主流程。
# 可对接 OpenAI / DeepSeek / 通义千问 / 智谱 GLM / 本地 vLLM 等（改 AI_BASE_URL 即可）
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# 单封报告最多分析的标的数量
REPORT_MAX_SYMBOLS=15

# ---- 多设备实时同步（默认关）----
# 设为 true 开启前端订阅 watchlists 变更自动刷新看板
ENABLE_REALTIME=false

# ----- Quote / chart cache TTL (seconds) -----
# Leave CACHE_QUOTE_TTL unset to use active/idle split.
# CACHE_QUOTE_TTL=3600
CACHE_QUOTE_TTL_ACTIVE=900
CACHE_QUOTE_TTL_IDLE=86400
CACHE_QUOTE_L1_TTL=60
CACHE_MEM_MAX_KEYS=40

# ---- 订阅（统一 $9.9/月；已注册用户 lifetime 不受影响）----
# 在 Supabase 执行 migrations/0003_subscription.sql 后：
# 1) 现有用户会被标为 plan=lifetime
# 2) 新用户默认 free，订阅后变为 pro
# 3) 确认无误后设 BILLING_REQUIRED=1 才开始对 free 用户门禁
BILLING_REQUIRED=0
PRO_PRICE_USD=9.9
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=https://timebricks.bid/?billing=success
BILLING_CANCEL_URL=https://timebricks.bid/?billing=cancel
